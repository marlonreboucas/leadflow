# Copie para a raiz na VPS:  cp docker/.env.production.example .env
# Exemplo RebFlow — troque senhas e domínios (NUNCA commite .env real)

NODE_ENV=production
TZ=America/Sao_Paulo

POSTGRES_USER=leadflow
POSTGRES_PASSWORD=CHANGE_ME_postgres_forte
POSTGRES_DB=leadflow
DATABASE_URL=postgresql://leadflow:CHANGE_ME_postgres_forte@postgres:5432/leadflow?schema=public

REDIS_URL=redis://redis:6379

API_PORT=3001

APP_URL=https://app.rebflow.com.br
API_URL=https://api.rebflow.com.br
WEBHOOK_PUBLIC_URL=https://api.rebflow.com.br

NEXT_PUBLIC_API_URL=https://api.rebflow.com.br
NEXT_PUBLIC_WS_URL=https://api.rebflow.com.br
NEXT_PUBLIC_EVOLUTION_URL=https://evo.rebflow.com.br

JWT_SECRET=CHANGE_ME_jwt_min_32_chars
JWT_REFRESH_SECRET=CHANGE_ME_refresh_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Nome do serviço no compose prod = "evolution" (não evolution-api)
EVOLUTION_API_URL=http://evolution:8080
EVOLUTION_API_KEY=CHANGE_ME_evolution_global_key
EVOLUTION_PUBLIC_URL=https://evo.rebflow.com.br

OPENAI_API_KEY=sk-CHANGE_ME
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STRIPE_SECRET_KEY=

# Opcional: origens CORS extras separadas por vírgula
# CORS_ORIGINS=https://outro-dominio.com
