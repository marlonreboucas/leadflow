# Copie para a raiz do projeto na VPS:  cp docker/.env.production.example .env
# Troque TODOS os valores marcados com CHANGE_ME

NODE_ENV=production
TZ=America/Sao_Paulo

POSTGRES_USER=leadflow
POSTGRES_PASSWORD=CHANGE_ME_postgres_forte
POSTGRES_DB=leadflow

REDIS_URL=redis://redis:6379

# URLs públicas (HTTPS após Caddy)
APP_URL=https://app.seudominio.com
API_URL=https://api.seudominio.com
WEBHOOK_PUBLIC_URL=https://api.seudominio.com

NEXT_PUBLIC_API_URL=https://api.seudominio.com
NEXT_PUBLIC_WS_URL=https://api.seudominio.com
NEXT_PUBLIC_EVOLUTION_URL=https://evo.seudominio.com

JWT_SECRET=CHANGE_ME_jwt_min_32_chars_random
JWT_REFRESH_SECRET=CHANGE_ME_refresh_min_32_chars_random

EVOLUTION_API_KEY=CHANGE_ME_evolution_global_key
EVOLUTION_PUBLIC_URL=https://evo.seudominio.com

OPENAI_API_KEY=sk-CHANGE_ME
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Opcional
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STRIPE_SECRET_KEY=
