# ===== Core =====
NODE_ENV=development
TZ=America/Sao_Paulo

# ===== Database =====
POSTGRES_USER=leadflow
POSTGRES_PASSWORD=leadflow_dev_password
POSTGRES_DB=leadflow
DATABASE_URL=postgresql://leadflow:leadflow_dev_password@localhost:5432/leadflow?schema=public

# ===== Redis =====
REDIS_URL=redis://localhost:6379

# ===== API =====
API_PORT=3001
API_URL=http://localhost:3001
APP_URL=http://localhost:3000
# URL que a Evolution (Docker) usa para chamar webhooks. No Windows com API no host:
# Windows + Docker: Evolution precisa alcançar a API no host (não use localhost aqui)
WEBHOOK_PUBLIC_URL=http://host.docker.internal:3001
# WEBHOOK_PUBLIC_URL=http://localhost:3001

# ===== Auth =====
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_REFRESH_SECRET=change-me-in-production-please-use-another-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ===== Evolution API =====
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=change-me-evolution-api-global-key

# ===== OpenAI (Fase 3 — NUNCA commitar chave real; só neste arquivo local) =====
# Gere em https://platform.openai.com/api-keys — se vazar, revogue na hora.
# A API OpenAI não usa seus dados de API para treinar modelos por padrão (ver política OpenAI).
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ===== Stripe (cobrança — opcional; sem chave o checkout ativa plano em modo dev) =====
# Chaves em https://dashboard.stripe.com/apikeys (use chave de teste em dev).
# STRIPE_WEBHOOK_SECRET: criado ao registrar o endpoint de webhook (whsec_...).
# Endpoint a cadastrar no Stripe: https://api.seudominio.com/webhooks/stripe
# Eventos: checkout.session.completed, customer.subscription.updated,
#          customer.subscription.deleted, invoice.payment_failed
# O price ID de cada plano vai em Plan.limits.stripePriceId (seed/admin).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ===== RLS Postgres (opcional — defesa em profundidade) =====
# Só ative DB_RLS=true APÓS aplicar scripts/enable-rls.sql e validar em staging.
# Com false (padrão) não há mudança de comportamento. Ver docs/RLS-OPTIONAL.md.
DB_RLS=false
DB_RLS_TX_TIMEOUT_MS=15000

# ===== Google Calendar (opcional) =====
# Console: https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:3001/api/integrations/google-calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== Web =====
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=http://localhost:3001
